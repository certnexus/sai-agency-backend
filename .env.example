# Server
PORT=5000
NODE_ENV=development

# MongoDB (local or Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gram_panchayat_tax)
MONGODB_URI=mongodb://127.0.0.1:27017/gram_panchayat_tax

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS - allowed frontend URLs, comma-separated (no trailing slash).
# localhost:5173 / :3000 are always allowed; in development any localhost port is.
CORS_ORIGINS=http://localhost:5173

# Default Admin (seeded on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
